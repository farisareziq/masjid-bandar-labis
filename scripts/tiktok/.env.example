# ============================================================
# Salin nilai ini ke fail .env di ROOT repo (skrip sedia ada
# sudah membaca .env di root), kemudian isi nilai sebenar.
# JANGAN commit .env.
# ============================================================

# --- Buffer (sambungan TikTok yang sudah diluluskan) ---
BUFFER_API_KEY=
BUFFER_CHANNEL_ID=
# Had tempoh video TikTok (saat). Video lebih panjang akan dilangkau.
BUFFER_MAX_DURATION_SEC=600

# --- TikTok langsung (tidak digunakan oleh auto-poster) ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8080/callback
TIKTOK_SCOPES=user.info.basic,video.publish,video.upload
# SELF_ONLY = ujian (sebelum review). PUBLIC_TO_EVERYONE selepas review lulus.
TIKTOK_PRIVACY=SELF_ONLY
# Token refresh daripada fail scripts/tiktok/tokens.json (untuk CI sahaja)
TIKTOK_REFRESH_TOKEN=

# --- Facebook (Graph API) - sedia ada ---
FB_ACCESS_TOKEN=
